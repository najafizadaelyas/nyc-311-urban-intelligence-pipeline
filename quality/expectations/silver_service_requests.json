{
  "data_asset_type": null,
  "expectation_suite_name": "silver_service_requests",
  "meta": {
    "great_expectations_version": "0.18.19",
    "description": "Quality contract for the Silver DuckDB layer. After the Polars cleaning pipeline, these stricter contracts must hold. Any violations here indicate a bug in the Silver cleaner or an unexpected data shape from the Bronze layer."
  },
  "expectations": [
    {
      "expectation_type": "expect_table_row_count_to_be_between",
      "kwargs": { "min_value": 1, "max_value": null }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": { "column": "unique_key", "mostly": 1.0 }
    },
    {
      "expectation_type": "expect_column_values_to_be_unique",
      "kwargs": {
        "column": "unique_key",
        "mostly": 1.0
      },
      "meta": {
        "notes": "Silver must be fully deduplicated — no duplicates allowed."
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": { "column": "created_date", "mostly": 1.0 }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "created_date",
        "min_value": "2020-01-01T00:00:00",
        "max_value": null,
        "mostly": 0.99
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "borough",
        "value_set": ["MANHATTAN", "BRONX", "BROOKLYN", "QUEENS", "STATEN ISLAND"],
        "mostly": 0.95
      },
      "meta": {
        "notes": "Borough must be one of the 5 valid NYC boroughs after cleaning. NULL is OK (originally Unspecified)."
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": {
        "column": "borough",
        "mostly": 0.95
      },
      "meta": {
        "notes": "At most 5% of rows can have NULL borough (originally Unspecified)."
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "latitude",
        "min_value": 40.4,
        "max_value": 40.95,
        "mostly": 0.99
      },
      "meta": {
        "notes": "All valid latitudes must fall within NYC bounding box."
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "longitude",
        "min_value": -74.3,
        "max_value": -73.7,
        "mostly": 0.99
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": { "column": "agency", "mostly": 0.99 }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": { "column": "complaint_type", "mostly": 0.99 }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "status",
        "value_set": ["OPEN", "CLOSED", "ASSIGNED", "PENDING", "IN_PROGRESS",
                      "DRAFT", "EMAIL_SENT", "MORE_INFO_REQUESTED"],
        "mostly": 0.99
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "response_hours",
        "min_value": 0,
        "max_value": null,
        "mostly": 1.0
      },
      "meta": {
        "notes": "response_hours must never be negative after cleaning. Negative values are nulled out in the Silver cleaner."
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_in_set",
      "kwargs": {
        "column": "created_year",
        "value_set": [2020, 2021, 2022, 2023, 2024, 2025, 2026],
        "mostly": 1.0
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "created_month",
        "min_value": 1,
        "max_value": 12,
        "mostly": 1.0
      }
    },
    {
      "expectation_type": "expect_column_values_to_be_between",
      "kwargs": {
        "column": "created_dow",
        "min_value": 0,
        "max_value": 6,
        "mostly": 1.0
      }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": { "column": "is_open_ticket", "mostly": 1.0 }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": { "column": "has_valid_geo", "mostly": 1.0 }
    },
    {
      "expectation_type": "expect_column_values_to_not_be_null",
      "kwargs": { "column": "_silver_cleaned_at", "mostly": 1.0 }
    }
  ]
}
