# ─────────────────────────────────────────────────────────────────────────────
# NYC 311 Urban Intelligence Pipeline — Environment Configuration
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is git-ignored — never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── Socrata API Token ─────────────────────────────────────────────────────────
# Optional. Without a token, the Socrata API allows 1,000 requests/hour.
# With a token, the limit increases to 10,000 requests/hour.
# Get a free token at: https://data.cityofnewyork.us/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# ── Database Paths (relative to project root) ────────────────────────────────
# Override these if you want to store DuckDB files in a custom location.
BRONZE_DB_PATH=data/bronze/bronze.duckdb
SILVER_DB_PATH=data/silver/silver.duckdb
GOLD_DB_PATH=data/gold/gold.duckdb

# ── Ingestion Config ─────────────────────────────────────────────────────────
# Initial load start date (only used on first run; incremental after that)
INGEST_START_DATE=2020-01-01

# Max rows per run (leave empty for unlimited; set to e.g. 50000 for dev)
INGEST_MAX_ROWS=

# ── dbt Config ────────────────────────────────────────────────────────────────
DBT_TARGET=dev
DBT_PROFILES_DIR=transform

# ── Dagster Config ────────────────────────────────────────────────────────────
DAGSTER_HOME=.dagster
DAGSTER_PORT=3001

# ── Evidence.dev Dashboard Config ────────────────────────────────────────────
EVIDENCE_DEV_PORT=3000

# ── Logging ───────────────────────────────────────────────────────────────────
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
