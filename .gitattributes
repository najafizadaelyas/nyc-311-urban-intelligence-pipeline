# Normalize line endings: LF in the repo, native on checkout
* text=auto

# Force LF for these file types (important for Makefile — tabs must be preserved)
*.py        text eol=lf
*.sql       text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.json      text eol=lf
*.sh        text eol=lf
Makefile    text eol=lf

# Binaries — no line-ending conversion
*.duckdb    binary
*.png       binary
*.jpg       binary
